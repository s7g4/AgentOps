# Copy to .env and fill in. Every value below is optional except where noted —
# AgentOps runs with zero configuration for local development.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Enables LLM-backed classification/planning/verification/response generation
# and OpenAI-backed goal decomposition. Omit to use the deterministic providers.
OPENAI_API_KEY=

# Set both once you have Redis — required for persistence and rate limiting
# to survive a restart or be shared across more than one replica.
REDIS_URL=redis://redis:6379/0
TRACE_BACKEND=memory
RATE_LIMIT_BACKEND=memory

# Required in any real deployment. Generate keys with: openssl rand -hex 32
AUTH_ENABLED=false
API_KEYS=

# OpenTelemetry — opt-in, requires the [otel] extras and a running collector.
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentops
